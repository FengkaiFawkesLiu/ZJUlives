<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#183D3B"/><Setter Property="Margin" Value="0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="box" Width="21" Height="21" CornerRadius="5" BorderThickness="1.5" BorderBrush="#6B9995" Background="{DynamicResource Glass.Input}" VerticalAlignment="Center">
          <Grid><TextBlock x:Name="tick" Text="✓" Foreground="#216F6B" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><Border x:Name="mixed" Width="10" Height="2" Background="#216F6B" Visibility="Collapsed"/></Grid>
        </Border><ContentPresenter Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="tick" Property="Visibility" Value="Visible"/><Setter TargetName="box" Property="Background" Value="{DynamicResource Glass.Selection}"/><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Glass.Edge}"/></Trigger>
        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="mixed" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#478368"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#216F6B"/><Setter TargetName="box" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="#183D3B"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="{DynamicResource Glass.Input}"/><Setter Property="BorderBrush" Value="#D3EBE8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="SelectionBrush" Value="#87E2DA"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="frame" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#216F6B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DatePickerTextBox">
    <Setter Property="Foreground" Value="#183D3B"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePickerTextBox"><Grid><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/><ContentControl x:Name="PART_Watermark" IsHitTestVisible="False" Foreground="#526D60" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DatePicker">
    <Setter Property="CalendarStyle" Value="{DynamicResource {x:Type Calendar}}"/>
    <Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#183D3B"/><Setter Property="MinHeight" Value="42"/><Setter Property="Background" Value="{DynamicResource Glass.Input}"/><Setter Property="SelectedDateFormat" Value="Short"/><Setter Property="BorderBrush" Value="#D3EBE8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
      <Border x:Name="frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><Grid x:Name="PART_Root"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
        <DatePickerTextBox x:Name="PART_TextBox" HorizontalContentAlignment="Stretch"/>
        <Button x:Name="PART_Button" Grid.Column="1" Margin="3" Padding="7" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip="选择日期"><Path Data="M 2,4 L 16,4 16,17 2,17 Z M 2,8 L 16,8 M 6,1 L 6,6 M 12,1 L 12,6" Stroke="#216F6B" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/></Button>
        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" Focusable="False"/>
      </Grid></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#216F6B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CalendarDayButton">
    <Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#183D3B"/><Setter Property="Margin" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarDayButton"><Grid Background="Transparent"><Border x:Name="hover" CornerRadius="7"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="today" Height="2" Width="12" Background="#216F6B" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers>
      <Trigger Property="IsToday" Value="True"><Setter TargetName="today" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Background" Value="#25FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="hover" Property="BorderBrush" Value="#216F6B"/><Setter TargetName="hover" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.3"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CalendarButton">
    <Setter Property="MinWidth" Value="48"/><Setter Property="MinHeight" Value="45"/><Setter Property="Foreground" Value="#183D3B"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarButton"><Border x:Name="frame" Background="Transparent" CornerRadius="8" Padding="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource Glass.Selection}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#216F6B"/><Setter TargetName="frame" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CalendarItem">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarItem"><ControlTemplate.Resources><DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type CalendarItem}, ResourceId=DayTitleTemplate}"><TextBlock Text="{Binding}" Foreground="#526D60" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5"/></DataTemplate></ControlTemplate.Resources><Grid x:Name="PART_Root"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Button x:Name="PART_PreviousButton" Content="‹" Margin="0" Padding="6" Background="Transparent" BorderThickness="0"/><Button x:Name="PART_HeaderButton" Grid.Column="1" Margin="0" Padding="8" Background="Transparent" BorderThickness="0"/><Button x:Name="PART_NextButton" Grid.Column="2" Content="›" Margin="0" Padding="6" Background="Transparent" BorderThickness="0"/></Grid>
      <Grid x:Name="PART_MonthView" Grid.Row="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
      <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Calendar">
    <Setter Property="Foreground" Value="#183D3B"/><Setter Property="Background" Value="#DDF7F5"/><Setter Property="BorderBrush" Value="{DynamicResource Glass.Edge}"/><Setter Property="CalendarItemStyle" Value="{StaticResource {x:Type CalendarItem}}"/><Setter Property="CalendarDayButtonStyle" Value="{StaticResource {x:Type CalendarDayButton}}"/><Setter Property="CalendarButtonStyle" Value="{StaticResource {x:Type CalendarButton}}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="8"><CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="42"/><Setter Property="Foreground" Value="#183D3B"/><Setter Property="Background" Value="{DynamicResource Glass.Input}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <Border x:Name="frame" Background="{TemplateBinding Background}" BorderBrush="#D3EBE8" BorderThickness="1" CornerRadius="8"/>
      <ContentPresenter x:Name="selection" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,6,35,6" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <Path x:Name="arrow" Data="M 0 0 L 4 4 L 0 8" Width="5" Height="9" Stroke="#216F6B" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
      <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" Margin="3,0,30,0" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}"/>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border x:Name="menu" Background="#DDF7F5" BorderBrush="{DynamicResource Glass.Edge}" BorderThickness="1.5" CornerRadius="11" Padding="5" Margin="0,5,0,0" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="selection" Property="Visibility" Value="Hidden"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#216F6B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="#183D3B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton x:Name="decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Margin="2" Background="#65739995"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
